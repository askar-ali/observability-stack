{
  "title": "Alerting and Prometheus Health",
  "uid": "prom-health",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "Firing alerts", "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "count(ALERTS{alertstate=\"firing\", alertname!=\"Watchdog\"}) or vector(0)" }] },
    { "id": 2, "type": "timeseries", "title": "Scrape targets up", "gridPos": { "x": 6, "y": 0, "w": 18, "h": 8 },
      "targets": [{ "expr": "sum by (job) (up)" }] },
    { "id": 3, "type": "timeseries", "title": "Samples ingested/s", "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "rate(prometheus_tsdb_head_samples_appended_total[5m])" }] }
  ]
}
